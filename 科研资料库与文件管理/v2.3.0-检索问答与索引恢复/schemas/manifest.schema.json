{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MANIFEST.json（归档清单）",
  "type": "object",
  "required": ["case_id", "archive_format", "archive_file",
               "created_utc", "file_count", "retention",
               "access_level", "files"],
  "properties": {
    "case_id": {"type": "string"},
    "archive_format": {"type": "string", "enum": ["tar.gz"]},
    "archive_file": {"type": "string"},
    "created_utc": {"type": "string"},
    "file_count": {"type": "integer", "minimum": 0},
    "member_count": {"type": "integer", "minimum": 0},
    "retention": {"$ref": "#/definitions/policy"},
    "access_level": {"$ref": "#/definitions/policy"},
    "pack_errors": {"type": "array", "items": {"type": "object"}},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "retention", "access_level"],
        "properties": {
          "path": {"type": "string"},
          "size": {"type": "integer"},
          "sha256": {"type": ["string", "null"],
                     "pattern": "^[0-9a-f]{64}$"},
          "mode": {"type": ["string", "null"]},
          "source": {"type": ["object", "null"]},
          "retention": {"type": "string"},
          "retention_source": {"type": ["string", "null"]},
          "access_level": {"type": "string"},
          "access_level_source": {"type": ["string", "null"]}
        }
      }
    }
  },
  "definitions": {
    "policy": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": {"type": "string"},
        "source": {"type": ["string", "null"]},
        "evidence": {"type": ["string", "null"]}
      }
    }
  }
}
