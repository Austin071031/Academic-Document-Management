{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "result.json contract for research-library-ledger-pipeline-v1",
  "type": "object",
  "required": ["case_id", "status", "sources", "uncertainty", "change_records"],
  "properties": {
    "case_id": {"type": ["string", "null"]},
    "status": {"type": "string", "enum": ["partial", "success", "failed"]},
    "generated_at": {"type": "string"},
    "finalized_at": {"type": "string"},
    "pipeline": {"type": "string"},
    "note": {"type": "string"},
    "_pending_fields": {"type": "array", "items": {"type": "string"}},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "path"],
        "properties": {
          "type": {"type": "string"},
          "path": {"type": "string"}
        }
      }
    },
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "change_records": {"type": "array", "items": {"type": "object"}},
    "verify": {
      "type": "object",
      "properties": {
        "verdict": {"type": "string", "enum": ["PASS", "FAIL", null]},
        "totals": {"type": "object"},
        "report": {"type": "string"}
      }
    }
  },
  "additionalProperties": true,
  "description": "output_contract 中的字段名以顶层附加属性出现（additionalProperties=true）；每个元数据取值必须可追溯到 sources 列出的产物。"
}
